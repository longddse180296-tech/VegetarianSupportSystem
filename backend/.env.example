# Copy to backend/.env for local Development and fill in your Gmail address and app password.
# Never commit the .env file or a real app password.
# Key Gemini chung cho chat, scan/OCR; key kiểm duyệt bài viết có thể khai báo riêng.
Gemini__ApiKey=
Gemini__ModerationApiKey=
# Tùy chọn model riêng cho cả văn bản/ảnh kiểm duyệt; để trống dùng model chung hiện hành.
Gemini__ModerationModel=
# Cấu hình máy cá nhân; thay server/database theo SQL Server của thành viên.
ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=VegetarianSupport;Integrated Security=true;TrustServerCertificate=true
Gemini__Model=gemini-2.5-flash
Gemini__ImageModel=gemini-2.5-flash
# Cài FFprobe hoặc điền đường dẫn tuyệt đối tới ffprobe.exe trên máy của bạn.
VideoMetadata__FfprobePath=ffprobe
# Để lưu upload tại .local ở gốc dự án, bỏ comment và thay đường dẫn tuyệt đối theo máy.
# Storage__PrivateRoot=E:\path\VegetarianSupportSystem\.local\media
# Storage__PublicImageRoot=E:\path\VegetarianSupportSystem\.local\public-images
# JWT dùng chung qua các lần khởi động: tự sinh khóa riêng >=32 byte, không dùng giá trị mẫu.
Authentication__Jwt__Issuer=VegetarianSupport.Development
Authentication__Jwt__Audience=VegetarianSupport.Swagger
Authentication__Jwt__SigningKey=
PasswordReset__ResetPageUrl=http://localhost:5173/#/auth/reset-password
PasswordReset__Smtp__Host=smtp.gmail.com
PasswordReset__Smtp__Port=587
PasswordReset__Smtp__From=
PasswordReset__Smtp__Username=
PasswordReset__Smtp__Password=
PasswordReset__Smtp__EnableSsl=true
